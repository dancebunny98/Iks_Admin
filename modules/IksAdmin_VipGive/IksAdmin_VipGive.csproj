<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- IksAdminApi лежит в этом же репозитории, в корне: /IksAdminApi/
         Private=false: на сервере она в shared/IksAdminApi/ - грузим оттуда. -->
    <ProjectReference Include="..\..\IksAdminApi\IksAdminApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- VipCoreApi.dll - бинарная зависимость от VIPCore (github.com/dancebunny98/cs2-VIPCorefork).
         Не исходники в репозитории (как раньше), а один файл VipCoreApi.dll, положенный
         автоматически скачивается workflow из release VIPCore в build-deps/.
         Нужен только для типа IVipCoreApi на этапе компиляции - сам VIPCore.dll на сервере
         подключается в рантайме через PluginCapability("vipcore:core"), не через эту сборку.
         Private=false ОБЯЗАТЕЛЕН: на сервере VipCoreApi.dll лежит в shared/VipCoreApi/, и
         capability.Get() отдаёт объект, реализующий ИМЕННО тот IVipCoreApi, что из shared/.
         Если модуль потащит свою копию - это будет другой CLR-тип, и приведение к нему
         либо упадёт с ошибкой, либо .Get() будет работать некорректно. -->
    <Reference Include="VipCoreApi">
      <HintPath>$(VipCoreApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
